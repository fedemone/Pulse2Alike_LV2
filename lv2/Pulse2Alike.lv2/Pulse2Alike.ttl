                       [ rdfs:label "PARA-4" ; rdf:value 9 ] ;
        rdfs:comment "UNISON-M/P and UNIAPW-M/P are eight detuned oscillators; PARA-8 and PARA-4 are paraphonic voices sharing the filter and VCA." ;
